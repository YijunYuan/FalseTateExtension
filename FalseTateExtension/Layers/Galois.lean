module

public import FalseTateExtension.Layers.Basic
public import Mathlib.FieldTheory.KummerExtension
public import Mathlib.FieldTheory.Normal.Basic
public import FontaineWintenberger.Mathlib.FieldTheory.FiniteIntermediateField

/-!
# Galois finite layers and infinite false Tate extensions

The actual cyclotomic layers are Galois. For a nonzero radicand, each diagonal
false Tate layer is the splitting field of its radical polynomial and is
Galois. Their directed suprema are therefore Galois as well.

This proves blueprint `ft:galois-layers`, the splitting-field argument in the
setup of Liu, Section 5.1 (printed page 82), at every prime including two.
-/

@[expose] public section

namespace FalseTateExtension

noncomputable section

open Polynomial FontaineWintenberger

variable {K : Type*} [Field K] [CharZero K] (p : ℕ) [Fact p.Prime]

/-- The actual finite cyclotomic layers are Galois over the base field. -/
instance cyclotomicLayer_isGalois (n : ℕ) :
    IsGalois K (cyclotomicLayer (K := K) p n) := by
  have : NeZero (p ^ n) := ⟨pow_ne_zero n (Fact.out : p.Prime).ne_zero⟩
  have : IsCyclotomicExtension {p ^ n} K (cyclotomicLayer (K := K) p n) :=
    (isPrimitiveRoot_rootOfUnity (K := K) p n).intermediateField_adjoin_isCyclotomicExtension K
  exact IsCyclotomicExtension.isGalois {p ^ n} K _

omit [CharZero K] in
/-- A chosen radical of a nonzero element is nonzero, at every index. -/
theorem radical_ne_zero (π : K) [hπ : NeZero π] (n : ℕ) : radical p π n ≠ 0 := by
  intro hzero
  have h := radical_pow p π n
  rw [hzero, zero_pow (pow_ne_zero n (Fact.out : p.Prime).ne_zero)] at h
  exact hπ.out ((algebraMap K (AlgebraicClosure K)).injective (by simpa using h.symm))

/-- The field generated by the roots of the radical polynomial is exactly
the actual diagonal false Tate layer, including at index zero. -/
theorem adjoin_rootSet_eq_falseTateLayer (π : K) [hπ : NeZero π] (n : ℕ) :
    IntermediateField.adjoin K
      ((X ^ (p ^ n) - C π : K[X]).rootSet (AlgebraicClosure K)) =
        falseTateLayer p π n n := by
  have hq : 0 < p ^ n := pow_pos (Fact.out : p.Prime).pos n
  have : NeZero (p ^ n) := ⟨hq.ne'⟩
  have hpoly : (X ^ (p ^ n) - C π : K[X]) ≠ 0 := X_pow_sub_C_ne_zero hq π
  have hroot (x : AlgebraicClosure K) :
      x ∈ (X ^ (p ^ n) - C π : K[X]).rootSet (AlgebraicClosure K) ↔
        x ^ (p ^ n) = algebraMap K (AlgebraicClosure K) π := by
    rw [Polynomial.mem_rootSet_of_ne hpoly]
    simp only [map_sub, map_pow, aeval_X, aeval_C, sub_eq_zero]
  have hα : radical p π n ≠ 0 := radical_ne_zero p π n
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    have hquot : (x / radical p π n) ^ (p ^ n) = 1 := by
      rw [div_pow, (hroot x).mp hx, radical_pow p π n]
      apply div_self
      rw [← radical_pow p π n]
      exact pow_ne_zero _ hα
    obtain ⟨i, _, hi⟩ :=
      (isPrimitiveRoot_rootOfUnity (K := K) p n).eq_pow_of_pow_eq_one hquot
    have hxmul : x = rootOfUnity p n ^ i * radical p π n := by
      rw [hi, div_mul_cancel₀ _ hα]
    rw [hxmul]
    exact (falseTateLayer p π n n).mul_mem
      ((falseTateLayer p π n n).toSubalgebra.pow_mem
        (rootOfUnity_mem_falseTateLayer p π n n) i)
      (radical_mem_falseTateLayer p π n n)
  · apply sup_le
    · apply IntermediateField.adjoin_simple_le_iff.mpr
      exact IntermediateField.subset_adjoin K _ ((hroot _).mpr (radical_pow p π n))
    · apply IntermediateField.adjoin_simple_le_iff.mpr
      have hαmem : radical p π n ∈ IntermediateField.adjoin K
          ((X ^ (p ^ n) - C π : K[X]).rootSet (AlgebraicClosure K)) :=
        IntermediateField.subset_adjoin K _ ((hroot _).mpr (radical_pow p π n))
      have hζαmem : rootOfUnity p n * radical p π n ∈ IntermediateField.adjoin K
          ((X ^ (p ^ n) - C π : K[X]).rootSet (AlgebraicClosure K)) := by
        apply IntermediateField.subset_adjoin K _
        apply (hroot _).mpr
        rw [mul_pow, rootOfUnity_pow, one_mul, radical_pow]
      have hd := (IntermediateField.adjoin K
        ((X ^ (p ^ n) - C π : K[X]).rootSet (AlgebraicClosure K))).div_mem hζαmem hαmem
      simpa only [mul_div_cancel_right₀ _ hα] using hd

/-- The actual diagonal field, rather than an isomorphic auxiliary copy, is
the splitting field of its radical polynomial. -/
theorem falseTateLayer_isSplittingField (π : K) [hπ : NeZero π] (n : ℕ) :
    (X ^ (p ^ n) - C π : K[X]).IsSplittingField K (falseTateLayer p π n n) := by
  rw [← adjoin_rootSet_eq_falseTateLayer p π n]
  exact IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

/-- Every diagonal finite false Tate layer with nonzero radicand is Galois,
including the base field at index zero and the prime two. -/
instance falseTateLayer_isGalois (π : K) [hπ : NeZero π] (n : ℕ) :
    IsGalois K (falseTateLayer p π n n) := by
  have := falseTateLayer_isSplittingField p π n
  exact IsGalois.of_separable_splitting_field
    (Polynomial.separable_X_pow_sub_C π
      (by exact_mod_cast pow_ne_zero n (Fact.out : p.Prime).ne_zero) hπ.out)

/-- The ordinary directed union of the finite cyclotomic layers is Galois. -/
instance cyclotomicExtension_isGalois : IsGalois K (cyclotomicExtension (K := K) p) := by
  have : Normal K (cyclotomicExtension (K := K) p) := by
    unfold cyclotomicExtension
    infer_instance
  exact {}

/-- Diagonal cofinality and normality of the actual finite splitting fields
make the full two-index false Tate extension Galois. -/
instance falseTateExtension_isGalois (π : K) [hπ : NeZero π] :
    IsGalois K (falseTateExtension p π) := by
  have : ∀ n, Normal K (falseTateLayer p π n n) :=
    fun n ↦ (falseTateLayer_isGalois p π n).to_normal
  have : Normal K (falseTateExtension p π) := by
    rw [falseTateExtension_eq_iSup_diagonal]
    infer_instance
  exact {}

/-- The diagonal layer `n` as a finite intermediate field of `K_FT`. -/
def falseTateDiagonalSubfield (π : K) (n : ℕ) :
    FiniteIntermediateField K (falseTateExtension p π) :=
  ⟨(IntermediateField.inclusion (falseTateLayer_le_falseTateExtension p π n n)).fieldRange,
    Module.Finite.equiv (IntermediateField.inclusion
      (falseTateLayer_le_falseTateExtension p π n n)).equivFieldRange.toLinearEquiv⟩

/-- The diagonal layer `n` is isomorphic to its image in `K_FT`. -/
def falseTateDiagonalSubfieldEquiv (π : K) (n : ℕ) :
    falseTateLayer p π n n ≃ₐ[K] (falseTateDiagonalSubfield p π n).val :=
  (IntermediateField.inclusion (falseTateLayer_le_falseTateExtension p π n n)).equivFieldRange

/-- Every finite subextension of `K_FT/K` lies in a diagonal layer. -/
theorem exists_le_falseTateDiagonalSubfield (π : K)
    (E : FiniteIntermediateField K (falseTateExtension p π)) :
    ∃ n, E ≤ falseTateDiagonalSubfield p π n := by
  classical
  have hfg : E.val.FG := IntermediateField.essFiniteType_iff.mp inferInstance
  obtain ⟨s, hs⟩ := hfg
  have hx (x : falseTateExtension p π) :
      ∃ n, (x : AlgebraicClosure K) ∈ falseTateLayer p π n n :=
    (mem_falseTateExtension_iff_diagonal p π (x : AlgebraicClosure K)).mp x.property
  choose level hlevel using hx
  refine ⟨s.sup level, ?_⟩
  change E.val ≤ (falseTateDiagonalSubfield p π (s.sup level)).val
  rw [← hs]
  apply IntermediateField.adjoin_le_iff.mpr
  intro x hx
  have hmem : (x : AlgebraicClosure K) ∈ falseTateLayer p π (s.sup level) (s.sup level) :=
    falseTateLayer_mono p π (Finset.le_sup (f := level) hx)
      (Finset.le_sup (f := level) hx) (hlevel x)
  change ∃ y : falseTateLayer p π (s.sup level) (s.sup level),
    IntermediateField.inclusion (falseTateLayer_le_falseTateExtension p π _ _) y = x
  exact ⟨⟨x, hmem⟩, Subtype.ext rfl⟩

theorem falseTateDiagonalSubfield_mono (π : K) {m n : ℕ} (h : m ≤ n) :
    falseTateDiagonalSubfield p π m ≤ falseTateDiagonalSubfield p π n := by
  rintro x ⟨y, rfl⟩
  exact ⟨IntermediateField.inclusion (falseTateLayer_mono p π h h) y, rfl⟩

instance falseTateDiagonalSubfield_isGalois (π : K) [hπ : NeZero π] (n : ℕ) :
    IsGalois K (falseTateDiagonalSubfield p π n).val :=
  haveI := falseTateLayer_isGalois p π n
  IsGalois.of_algEquiv (falseTateDiagonalSubfieldEquiv p π n)

end

end FalseTateExtension
